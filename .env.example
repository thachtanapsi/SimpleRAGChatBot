# Tất cả biến đều tùy chọn. Ứng dụng không tự đọc file .env.
RAG_BASE_DIR=.
RAG_DATA_DIR=./data
RAG_PAPERS_DIR=./papers
RAG_EMBEDDING_MODEL=BAAI/bge-m3
# Có thể pin commit Hugging Face để fingerprint tái lập tuyệt đối.
# RAG_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
RAG_EMBED_DEVICE=auto
RAG_EMBED_BATCH_SIZE=32
RAG_CHAT_MODEL=gemma4:e2b
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_ANSWER_NUM_PREDICT=2048
# Advanced RAG dùng giới hạn riêng; hợp lệ từ 256 đến 1024.
RAG_ADVANCED_ANSWER_NUM_PREDICT=1024
RAG_REWRITE_NUM_PREDICT=96
RAG_CROSS_PAGE_ENABLED=1
RAG_CROSS_PAGE_CONTEXT_CHARS=1200
RAG_DENSE_SEARCH_K=30
RAG_LEXICAL_SEARCH_K=30
RAG_RRF_K=60
RAG_DENSE_WEIGHT=0.7
RAG_LEXICAL_WEIGHT=0.3
# Full eval gần nhất chưa qua citation/abstention gate; bật 1 để thử hybrid.
RAG_HYBRID_SEARCH=0
RAG_RELEVANCE_THRESHOLD=0.35
# Cross-encoder chạy local_files_only; preload model trước khi bật.
RAG_RERANK_ENABLED=0
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAG_RERANK_REVISION=<hugging-face-commit>
RAG_RERANK_DEVICE=auto
RAG_RERANK_BATCH_SIZE=8
RAG_RERANK_CANDIDATE_K=40
RAG_RERANK_CHILD_K=12
RAG_RERANK_MIN_SCORE=0.5
# Bật tuần tự: reranker -> Agentic -> Self-check -> graph build -> graph route.
RAG_AGENTIC_ENABLED=0
RAG_SELF_CHECK_ENABLED=0
RAG_GRAPH_BUILD_ENABLED=0
RAG_GRAPH_ENABLED=0
# Mặc định theo RAG_CHAT_MODEL nếu bỏ trống biến môi trường.
RAG_REVIEW_MODEL=gemma4:e2b
RAG_GRAPH_EXTRACTOR_MODEL=gemma4:e2b
RAG_AGENT_TIMEOUT_SECONDS=120
RAG_AGENT_MAX_RETRIEVAL_ROUNDS=2
RAG_AGENT_MAX_SUBQUERIES=3
RAG_AGENT_MAX_TOOL_CALLS=4
RAG_SELF_CHECK_MAX_ANSWER_ATTEMPTS=2
RAG_GRAPH_MAX_HOPS=2
RAG_GRAPH_WORKER_CONCURRENCY=1
RAG_LOG_LEVEL=INFO
# Bắt buộc cho /internal/v1/digest-batches/*; dùng secret dài, sinh ngẫu nhiên.
# RAG_SERVICE_API_KEY=replace-with-a-long-random-secret
RAG_DIGEST_MAX_BATCH_SIZE=50
RAG_DIGEST_WRITER_CLAIM_SIZE=25
